{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "DSH 桌面版（无 Electron · Tauri v2 壳 + 内置 dsh 运行时）",
  "scripts": {
    "payload:assemble": "node scripts/assemble-payload.mjs",
    "payload:verify": "node scripts/verify-payload.mjs",
    "shell:dev": "DSH_DESKTOP_NODE=$PWD/payload/node/bin/node npm --prefix shell run tauri dev",
    "shell:build": "DSH_DESKTOP_NODE=$PWD/payload/node/bin/node npm --prefix shell run tauri build"
  },
  "engines": { "node": ">=20" }
}